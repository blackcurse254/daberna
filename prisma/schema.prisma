// Prisma Schema for Daberna Land VIP (Production Free-to-Play Platform)
// Datasource: PostgreSQL
// Generator: Prisma Client JS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum VipLevel {
  BRONZE
  SILVER
  GOLD
  DIAMOND_VIP
  SUPER_ADMIN
}

model User {
  id           Int         @id @default(autoincrement())
  username     String      @unique @db.VarChar(50)
  passwordHash String      @db.VarChar(255)
  salt         String      @db.VarChar(64)
  fullname     String      @default("") @db.VarChar(100)
  phone        String      @default("") @db.VarChar(20)
  email        String      @default("") @db.VarChar(100)
  joinedDate   String      @default("1402/10/01")
  vipLevel     VipLevel    @default(BRONZE)
  totalGames   Int         @default(0)
  totalWins    Int         @default(0)
  totalScore   BigInt      @default(0)
  chips        BigInt      @default(350000)
  status       UserStatus  @default(ACTIVE)
  role         UserRole    @default(PLAYER)
  lastDailyClaim DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  scoreHistory ScoreTransaction[]
  chatMessages ChatMessage[]
  auditLogs    AuditLog[]         @relation("AuditSubject")

  @@index([username])
  @@index([totalScore])
  @@index([role])
}

model ScoreTransaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  username    String   @db.VarChar(50)
  type        String   @db.VarChar(100) // e.g. "برد جایزه دبرنا", "پاداش ورود روزانه", "ورودی بازی رایگان"
  amount      BigInt   // Virtual free chips (+ or -)
  status      String   @default("موفق") @db.VarChar(30)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([username])
  @@index([createdAt])
}

model GameRoom {
  id           String   @id @db.VarChar(30) // bronze, silver, gold
  name         String   @db.VarChar(100)
  tag          String   @db.VarChar(100)
  entryChips   Int      @default(20000)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GameMatch {
  id              Int      @id @default(autoincrement())
  roomId          String   @db.VarChar(30)
  roomName        String   @db.VarChar(100)
  drawnNumbers    String   @db.Text // Comma-separated numbers e.g. "7,23,54,89,..."
  totalNumbers    Int      @default(0)
  line1Winner     String?  @db.VarChar(50)
  line2Winner     String?  @db.VarChar(50)
  fullHouseWinner String?  @db.VarChar(50)
  potChips        BigInt   @default(0)
  gameSeed        String   @db.VarChar(100)
  gameHash        String   @db.VarChar(100)
  createdAt       DateTime @default(now())

  @@index([roomId])
  @@index([createdAt])
}

model ChatMessage {
  id          Int      @id @default(autoincrement())
  roomId      String   @db.VarChar(30)
  userId      Int?
  sender      String   @db.VarChar(50)
  text        String   @db.VarChar(500)
  isReaction  Boolean  @default(false)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([createdAt])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String   @db.VarChar(100)
  performedBy String   @db.VarChar(50)
  target      String?  @db.VarChar(100)
  details     String?  @db.Text
  ipAddress   String?  @db.VarChar(50)
  userId      Int?
  createdAt   DateTime @default(now())

  user        User?    @relation("AuditSubject", fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([performedBy])
  @@index([createdAt])
}

model SystemConfig {
  key         String   @id @db.VarChar(50)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt
}

model SystemErrorLog {
  id          Int      @id @default(autoincrement())
  level       String   @default("ERROR") @db.VarChar(20)
  message     String   @db.Text
  stack       String?  @db.Text
  endpoint    String?  @db.VarChar(255)
  ipAddress   String?  @db.VarChar(50)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
