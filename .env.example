# Daberna Land VIP - Environment Configuration Blueprint

# Application Environment (production / development)
NODE_ENV="production"

# Application Port
PORT=3000

# Public URL where the application is hosted (e.g., https://daberna.vip)
APP_URL="http://localhost:3000"

# PostgreSQL Database Connection String for Prisma ORM
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://daberna_user:DabernaSecurePass2026_VIP@postgres:5432/daberna_vip_db?schema=public"

# Session Security & Cryptographic Signing Secret Key (HMAC-SHA256)
# Generate a high-entropy 64-character hex key in production
SESSION_SECRET="e4c19a8f276b539401d67a12b9ef38dc49015c9284ba37de2f9103c847ea6102"

# Initial Super Admin Credentials
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="AdminSecurePassword@90"

# Allowed CORS Origins (comma-separated or * for public APIs)
CORS_ORIGIN="*"

# Optional Gemini API Key for Server-side AI Features (if configured)
GEMINI_API_KEY=""
